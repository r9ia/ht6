# Copy to .env and add newly rotated credentials locally. Never commit .env.
ENABLE_CLOUD_NARRATION=false
ENABLE_MICROPHONE_CONVERSATION=false
NARRATION_BRIDGE_HOST=127.0.0.1
NARRATION_BRIDGE_PORT=8787
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# SmartSpectra sensor host (local SDK and secret; never commit real values)
SMARTSPECTRA_API_KEY=
SMARTSPECTRA_SDK_PATH=.local/smartspectra-sdk/windows-x64

# Unifold reward bridge (Night Watch Contract). Mock by default: leave these blank
# and the bridge simulates payouts locally. Live sandbox payouts require the opt-in
# flag AND every field below. Never commit a real sk_ key.
ENABLE_UNIFOLD_REWARDS=false
UNIFOLD_BRIDGE_HOST=127.0.0.1
UNIFOLD_BRIDGE_PORT=8788
UNIFOLD_API_BASE=https://api.unifold.io
UNIFOLD_SECRET_KEY=
UNIFOLD_TREASURY_ACCOUNT_ID=
UNIFOLD_TREASURY_CHAIN_ID=8453
UNIFOLD_DEMO_RECIPIENT_ADDRESS=
UNIFOLD_REWARD_CHAIN_TYPE=ethereum
UNIFOLD_REWARD_CHAIN_ID=8453
UNIFOLD_REWARD_TOKEN_ADDRESS=0x833589fcd6edb6e08f4c7c32d4f71b54bda02913
UNIFOLD_REWARD_TOKEN_DECIMALS=6
UNIFOLD_MAX_REWARD_USD=5
